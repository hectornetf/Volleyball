#!/usr/bin/env sh
# =============================================================
# PRÉ-COMMIT HOOK — VoleizinDosCria
# Este hook bloqueia commits que falham nas checagens de
# código e segurança das versões Web e Mobile.
# =============================================================

echo ""
echo "🛡️  Iniciando verificação pré-commit (código + segurança)..."
echo ""

root="$(git rev-parse --show-toplevel)"

# Incrementa o número de versão (Web + Mobile) antes de buildar
node "$root/scripts/bump-version.js"

# Re-adiciona os arquivos de versão atualizados ao index (fazem parte do commit)
git add "$root/web/package.json" "$root/web/package-lock.json" \
        "$root/mobile/package.json" "$root/mobile/package-lock.json" \
        "$root/mobile/app.json"

# Executa o script de verificação com Node.js
node "$root/scripts/verify.js"

# Captura o código de saída do script
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "❌ COMMIT CANCELADO. Corrija os problemas listados acima."
  echo ""
  exit 1
fi

exit 0
