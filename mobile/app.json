{
  "expo": {
    "name": "Voleizin Dos Cria",
    "slug": "voleizin-dos-cria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voleizindoscria.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voleizindoscria.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9169bdc2-da1a-492b-9db0-549e111c7fd6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9169bdc2-da1a-492b-9db0-549e111c7fd6"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f1a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0b0f1a",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ]
